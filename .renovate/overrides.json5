{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Override Talos Installer Package Name",
      matchDatasources: ["docker"],
      matchPackageNames: ["/factory\\.talos\\.dev/"],
      overridePackageName: "ghcr.io/siderolabs/installer",
    },
    {
      description: "Disable Dead Factory Installer Deps (the Kubernetes manager extracts factory.talos.dev image deps that duplicate the dedicated custom manager and never update)",
      matchManagers: ["kubernetes"],
      matchDepNames: ["/factory\\.talos\\.dev/"],
      enabled: false,
    },
    {
      description: "Disable Radar Helm Chart Auto-Bump (radar runs the OxygnCorp/containers graft image pinned to a specific upstream release; the chart and the graft binary must bump in lockstep because new charts pass flags older binaries reject. Chart bumps ride along with a new graft image build in the containers repo, not auto-bumped here)",
      matchManagers: ["flux"],
      matchDepNames: ["radar"],
      enabled: false,
    },
    {
      description: "Cadence Weekly For llama.cpp Digests (Frequent Upstream Builds, Breaking CLI Changes)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/ggml-org/llama.cpp"],
      schedule: ["before 6am on monday"],
    },
  ],
}
