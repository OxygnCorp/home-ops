{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    // ── Trusted rules (existantes, conservées) ────────────────────────────
    {
      description: "Auto-merge trusted container digests and patches",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["digest", "patch"],
      matchPackageNames: ["/home-operations/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge OCI Charts",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate container",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      matchPackageNames: ["/renovatebot/renovate/", "/renovate-operator/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "/^actions\\//",
        "/^renovatebot\\//",
      ],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge GitHub Releases",
      matchDatasources: ["github-releases"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/external-dns/", "/gateway-api/", "/prometheus-operator/"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge npm minor and patch",
      matchDatasources: ["npm"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    // ── Règle large (avant les exclusions : l'exclusion l'emporte en bas) ─
    {
      description: "Auto-merge minor/patch/digest container & chart updates (3-day release age)",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
      addLabels: ["automerge"],
    },
    // ── Exclusions core (dernier mot pour ces packages) ───────────────────
    {
      description: "Exclude core/sensitive components from automerge",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      matchPackagePatterns: [
        // Réseau / DNS / gateway
        "/^ghcr.io/coredns/",
        "/envoyproxy/envoy/",
        "/gateway-api/",
        "/cilium/",
        // Secrets / identité
        "/1password/",
        "/external-secrets/",
        "/cert-manager/",
        "/kanidm/",
        // Stockage / données
        "/cloudnative-pg/",
        "/openebs/",
        "/miroir/",
        "/kopiur/",
        "/tuppr/",
        "/rook-ceph/",
        // Chaîne d'IA / délégation (litellm fait tourner l'AI review)
        "/litellm/",
        "/toolhive/",
        "/memini/",
        "/mcp-grafana/",
        "/unifi-network-mcp/",
        "/konflate/",
        // CI / GitOps core
        "/gha-runner-scale-set/",
        "/flux-operator/",
        "/flux-instance/",
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
        "/factory\\.talos\\.dev/",
        "/siderolabs/installer/",
      ],
      automerge: false,
    },
    // ── Défense en profondeur ─────────────────────────────────────────────
    {
      description: "Never auto-merge major updates",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],
}
