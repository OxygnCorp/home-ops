{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    // ── Trusted rules (existantes, conservées) ────────────────────────────
    {
      description: "Auto-merge trusted container digests and patches",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["digest", "patch"],
      matchPackageNames: ["/^ghcr.io\\/home-operations\\//"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge OCI Charts",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate container",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      matchPackageNames: ["/renovatebot/renovate/", "/renovate-operator/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "/^actions\\//",
        "/^renovatebot\\//",
      ],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge GitHub Releases",
      matchDatasources: ["github-releases"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/external-dns/", "/gateway-api/", "/prometheus-operator/"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge npm minor and patch",
      matchDatasources: ["npm"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    // ── Règle large — marker de skip par PRÉFIXE DE BRANCHE ("renovate/am-"),
    // NOT par label : Renovate rejette les regex avec lookahead dans
    // matchPackageNames (config-validator: "Failed to parse regex pattern"),
    // et addLabels est mergeable (le label fuiterait sur les exclusions) —
    // un marker non mergeable (additionalBranchPrefix) se réinitialise à ""
    // dans la règle d'exclusion en dessous. ─────────────────────────────────
    {
      description: "Auto-merge minor/patch/digest updates (1-hour release age, non-core packages)",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 hour",
      ignoreTests: false,
      additionalBranchPrefix: "am-",
    },
    // ── Exclusions core — réinitialise le marker de branche ("") et pose
    // automerge: false en dernier mot ─────────────────────────────────────
    {
      description: "Exclude core/sensitive components from automerge",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      additionalBranchPrefix: "",
      matchPackageNames: [
        // Réseau / DNS / gateway
        "/coredns/",
        "/envoyproxy/envoy/",
        "/envoyproxy/gateway/",
        "/envoy-gateway/",
        "/gateway-api/",
        "/cilium/",
        // Secrets / identité
        "/authentik/",
        "/1password/",
        "/external-secrets/",
        "/cert-manager/",
        "/kanidm/",
        // Stockage / données
        "/cloudnative-pg/",
        "/openebs/",
        "/miroir/",
        "/kopiur/",
        "/tuppr/",
        "/rook-ceph/",
        // Chaîne d'IA / délégation (litellm fait tourner l'AI review)
        "/litellm/",
        "/toolhive/",
        "/memini/",
        "/mcp-grafana/",
        "/unifi-network-mcp/",
        "/konflate/",
        // CI / GitOps core
        "/gha-runner-scale-set/",
        "/flux-operator/",
        "/flux-instance/",
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
        "/factory\\.talos\\.dev/",
        "/siderolabs/installer/",
      ],
      automerge: false,
    },
    // ── Défense en profondeur ─────────────────────────────────────────────
    {
      description: "Never auto-merge major updates",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],
}
