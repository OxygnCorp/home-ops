{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "abandonments:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>OxygnCorp/home-ops//.renovate/autoMerge.json5",
    "github>OxygnCorp/home-ops//.renovate/changelogs.json5",
    "github>OxygnCorp/home-ops//.renovate/customManagers.json5",
    "github>OxygnCorp/home-ops//.renovate/grafanaDashboards.json5",
    "github>OxygnCorp/home-ops//.renovate/groups.json5",
    "github>OxygnCorp/home-ops//.renovate/labels.json5",
    "github>OxygnCorp/home-ops//.renovate/overrides.json5",
    "github>OxygnCorp/home-ops//.renovate/semanticCommits.json5",
    "github>OxygnCorp/home-ops//.renovate/talosFactory.json5",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Paris)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  // The docker datasource only gets releaseTimestamps from Docker Hub
  // (tag_last_pushed). Every other registry in use (ghcr.io, forgejo,
  // gsoci.azurecr.io, mirror.gcr.io, private registries) — plus Docker Hub
  // digest updates — exposes no timestamps. With Renovate v44 defaults
  // (minimumReleaseAgeBehaviour "timestamp-required" + internalChecksFilter
  // "strict"), every timestamp-less update matched by a minimumReleaseAge
  // rule stays "pending" forever and its branch is never created (the
  // "Pending Status Checks" flood on the dashboard). "timestamp-optional"
  // keeps the age gate wherever a timestamp exists and proceeds otherwise.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/resources/**",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
}
