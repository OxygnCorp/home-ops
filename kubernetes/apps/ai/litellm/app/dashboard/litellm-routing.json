      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Prompt + completion token rate per virtual key.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
