{
  "id": null,
  "uid": "llm-routing",
  "title": "LiteLLM — Virtual Keys",
  "description": "Per-virtual-key consumption, reliability and routing.",
  "tags": [
    "llm",
    "litellm",
    "virtual-keys"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      },
      {
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(litellm_proxy_total_requests_metric_total{api_key_alias!=\"None\"}, api_key_alias)",
        "hide": 0,
        "includeAll": true,
        "label": "Virtual key",
        "multi": true,
        "name": "consumer",
        "options": [],
        "query": {
          "query": "label_values(litellm_proxy_total_requests_metric_total{api_key_alias!=\"None\"}, api_key_alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model!=\"\"}, requested_model)",
        "hide": 0,
        "includeAll": true,
        "label": "Model",
        "multi": true,
        "name": "model",
        "options": [],
        "query": {
          "query": "label_values(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model!=\"\"}, requested_model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "LiteLLM-calculated spend in the selected range. Subscription/local models can be $0.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(litellm_spend_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Spend",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Prompt + completion tokens in the selected range.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(litellm_total_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Tokens",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total proxy requests, success and failures.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Failed proxy requests divided by total requests.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (sum(increase(litellm_proxy_failed_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) or vector(0)) / clamp_min((sum(increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) or vector(0)), 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "95th percentile end-to-end request latency.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_request_total_latency_metric_bucket{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__rate_interval]))) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "p95 Latency",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Average total tokens per proxy request; the numerator counts successful requests only, so failures are not included.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(litellm_total_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) or vector(0)) / clamp_min((sum(increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) or vector(0)), 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Tokens / Request",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "panels": [],
      "title": "Consumption by Virtual Key",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Requests, spend, tokens, errors and latency per virtual key. The global Mainclaw/Devclaw keys aggregate fallback traffic (images, MCP), not a single workload.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Spend"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "$ / 1k tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 6
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 9,
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_spend_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_total_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_input_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_output_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "E",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_input_cached_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "F",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_output_reasoning_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "G",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_proxy_failed_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range]))",
          "refId": "H",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (api_key_alias) (increase(litellm_proxy_failed_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) / clamp_min(sum by (api_key_alias) (increase(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])), 1)",
          "refId": "I",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, api_key_alias) (rate(litellm_request_total_latency_metric_bucket{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__rate_interval])))",
          "refId": "J",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (increase(litellm_spend_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])) / clamp_min(sum by (api_key_alias) (increase(litellm_total_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__range])), 1) * 1000",
          "refId": "K",
          "instant": true,
          "format": "table"
        }
      ],
      "title": "Consumption by Virtual Key",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "api_key_alias",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time 9": true,
              "Time 10": true
            },
            "renameByName": {
              "api_key_alias": "Virtual key",
              "Value #A": "Requests",
              "Value #B": "Spend",
              "Value #C": "Total tokens",
              "Value #D": "Input tokens",
              "Value #E": "Output tokens",
              "Value #F": "Cached input",
              "Value #G": "Reasoning tokens",
              "Value #H": "Errors",
              "Value #I": "Error rate",
              "Value #J": "p95 latency",
              "Value #K": "$ / 1k tokens"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 10,
      "panels": [],
      "title": "Trends",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "LiteLLM-calculated hourly spend rate per virtual key.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
