      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api_key_alias) (rate(litellm_total_tokens_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__rate_interval])) * 60 > 0",
          "refId": "A",
          "legendFormat": "{{api_key_alias}}"
        }
