          },
          "expr": "sum by (api_key_alias) (rate(litellm_proxy_total_requests_metric_total{api_key_alias=~\"$consumer\", api_key_alias!=\"None\", requested_model=~\"$model\"}[$__rate_interval])) * 60 > 0",
          "refId": "A",
          "legendFormat": "{{api_key_alias}}"
        }
      ],
      "title": "Request Rate by Virtual Key (req/min)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Failed requests as a percentage of total requests per virtual key.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 14,
      "options": {
        "legend": {
          "displayMode": "list",
